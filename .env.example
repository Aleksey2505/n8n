
# OpenAI
OPENAI_API_KEY=sk-...


# Basic Auth for n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123


# Database (если используешь внешний DB в production, укажи сюда)
DATABASE_TYPE=postgresdb
DATABASE_URL=postgres://n8n:n8n_password@postgres:5432/n8n


# Timezone
GENERIC_TIMEZONE=Europe/Moscow
